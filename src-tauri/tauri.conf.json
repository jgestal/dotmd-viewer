{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DotMD Viewer",
  "version": "0.0.1",
  "identifier": "es.gestal.dotmdviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DotMD Viewer",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
